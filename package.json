{
  "name": "hacktx-trip-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean:test-build": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\"",
    "pretest:planning": "npm run clean:test-build",
    "test:planning": "tsc -p tsconfig.tests.json && node --test .test-build/tests/planning-context.test.js",
    "posttest:planning": "npm run clean:test-build",
    "pretest:candidates": "npm run clean:test-build",
    "test:candidates": "tsc -p tsconfig.tests.json && node --test .test-build/tests/candidate-planner.test.js",
    "posttest:candidates": "npm run clean:test-build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
