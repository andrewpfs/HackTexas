{
  "name": "hacktx-trip-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:check": "node scripts/check-db.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "clean:test-build": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\"",
    "pretest:planning": "npm run clean:test-build",
    "test:planning": "tsc -p tsconfig.tests.json && node --test .test-build/tests/planning-context.test.js",
    "posttest:planning": "npm run clean:test-build",
    "pretest:candidates": "npm run clean:test-build",
    "test:candidates": "tsc -p tsconfig.tests.json && node --test .test-build/tests/candidate-planner.test.js",
    "posttest:candidates": "npm run clean:test-build",
    "pretest:muse": "npm run clean:test-build",
    "test:muse": "tsc -p tsconfig.tests.json && node --test .test-build/tests/muse-planner.test.js",
    "posttest:muse": "npm run clean:test-build",
    "pretest:voting": "npm run clean:test-build",
    "test:voting": "tsc -p tsconfig.tests.json && node --test .test-build/tests/voting-itinerary.test.js",
    "posttest:voting": "npm run clean:test-build",
    "pretest:revision": "npm run clean:test-build",
    "test:revision": "tsc -p tsconfig.tests.json && node --test .test-build/tests/revision.test.js",
    "posttest:revision": "npm run clean:test-build",
    "pretest:prefs": "npm run clean:test-build",
    "test:prefs": "tsc -p tsconfig.tests.json && node --test .test-build/tests/preferences-and-dates.test.js",
    "posttest:prefs": "npm run clean:test-build",
    "pretest:avatar": "npm run clean:test-build",
    "test:avatar": "tsc -p tsconfig.tests.json && node --test .test-build/tests/avatar.test.js",
    "posttest:avatar": "npm run clean:test-build",
    "pretest:travel": "npm run clean:test-build",
    "test:travel": "tsc -p tsconfig.tests.json && node --test .test-build/tests/travel.test.js",
    "posttest:travel": "npm run clean:test-build",
    "pretest:connect": "npm run clean:test-build",
    "test:connect": "tsc -p tsconfig.tests.json && node --require ./tests/stub-server-only.cjs --test .test-build/tests/sketch-phone-mcp.test.js",
    "posttest:connect": "npm run clean:test-build",
    "pretest:places": "npm run clean:test-build",
    "test:places": "tsc -p tsconfig.tests.json && node --test .test-build/tests/serpapi-places.test.js",
    "posttest:places": "npm run clean:test-build",
    "test": "npm run test:planning && npm run test:candidates && npm run test:updates && npm run test:muse && npm run test:voting && npm run test:places && npm run test:revision && npm run test:prefs && npm run test:avatar && npm run test:travel && npm run test:connect && npm run test:improvements && npm run test:manual-hotels",
    "pretest:updates": "npm run clean:test-build",
    "test:updates": "tsc -p tsconfig.tests.json && node --test .test-build/tests/trip-updates.test.js",
    "posttest:updates": "npm run clean:test-build",
    "test:improvements": "tsc -p tsconfig.tests.json && node --require ./tests/stub-server-only.cjs --test .test-build/tests/improvements.test.js",
    "pretest:improvements": "npm run clean:test-build",
    "posttest:improvements": "npm run clean:test-build",
    "pretest:manual-hotels": "npm run clean:test-build",
    "test:manual-hotels": "tsc -p tsconfig.tests.json && node --require ./tests/stub-server-only.cjs --test .test-build/tests/manual-hotel.test.js",
    "posttest:manual-hotels": "npm run clean:test-build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
