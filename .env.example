# Muse / Meta Model API (server-side only; put real values in .env.local)
META_API_KEY=your_meta_api_key
# Optional overrides. Defaults: https://api.meta.ai/v1 and muse-spark-1.3
META_API_BASE_URL=
META_MODEL=
# Set to true to fall back to the mock planner if Muse fails during a demo
MUSE_FALLBACK_TO_MOCK=false

# Supabase database (server-side only). Without these, trips are stored in data/trips.json.
# Find them in the Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# SerpApi (server-side only): real places, ratings, and reviews for the shared itinerary.
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key
# Set to false to skip review snippets (uses about half as many searches)
SERPAPI_INCLUDE_REVIEWS=true

# Phone sign-in (no accounts). Without Twilio, codes are shown on screen in a labeled demo mode.
# Create a Verify service at https://console.twilio.com and copy its SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# A long random string. Signs sign-in sessions and hashes phone numbers and assistant tokens.
SESSION_SECRET=
